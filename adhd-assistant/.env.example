# Copia este archivo como ".env" en la raíz del proyecto y llena los valores.
# NUNCA subas el .env real a un repositorio ni a zips de auditoría.

# --- Groq (clasificación + extracción + charla) ---
GROQ_API_KEY=tu_clave_de_groq

# --- Vikunja (tareas) ---
# ⚠️ El token antiguo que estaba escrito en tasks_sync.py quedó expuesto:
# REVÓCALO en Vikunja (Área personal > Tokens de API) y genera uno nuevo.
VIKUNJA_URL=http://192.168.1.20:3456
VIKUNJA_TOKEN=tk_aqui_tu_token_nuevo
VIKUNJA_PROJECT_ID=1

# --- Voz del asistente (opcional; por defecto usa config.json) ---
# Valores: dalia_tierna, camila_dulce, salome_energica, jorge_jovial,
#          dalia_natural, elvira_zen
ASISTENTE_VOZ=dalia_natural

# --- Puerto del panel (opcional, por defecto 8765) ---
# Solo lo cambias si tienes otro programa usando el 8765.
# pruebas_automaticas.py usa el 8799 para no chocar con tu servidor.
# ASISTENTE_PUERTO=8765

