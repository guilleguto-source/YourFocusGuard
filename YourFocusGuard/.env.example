# Cópialo como .env en la raíz del proyecto y rellena lo que uses.
# El agente degrada a heurística local (Nivel B) si falta la clave.

# Gemini (con capa gratuita de prueba): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Groq (voz Whisper ultrarrápida + personalidades estilo Muse): https://console.groq.com/keys
GROQ_API_KEY=
